# Docker Compose reads this file only after copying to .env.
# Native Python needs explicit environment variables; real values must not be committed.
HOTSTOCK_API_KEY=
WITH_PUBLIC_DATA=1
MARKET_DATA_URL=
MARKET_MCP_TOKEN=
# Optional external Docker network containing the existing market-data service.
MARKET_NETWORK=
# Optional article-only AI summaries; disabled by default.
HOTSTOCK_LLM_ENABLED=0
HOTSTOCK_LLM_BASE_URL=
HOTSTOCK_LLM_MODEL=
HOTSTOCK_LLM_API_KEY=
HOTSTOCK_SHARED_DATA_TOKEN=
HOTSTOCK_TUSHARE_TOKEN=
